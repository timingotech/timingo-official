# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=replace_with_rotated_resend_api_key

# Email Configuration
FROM_NAME="TimingoTech"
FROM_EMAIL=team@timingotech.com
ADMIN_EMAIL=team@timingotech.com

# For Vercel deployment, add RESEND_API_KEY to Environment Variables:
# 1. Go to your Vercel project settings
# 2. Navigate to "Environment Variables"
# 3. Add: RESEND_API_KEY=<your rotated Resend API key>

# --- Reminders page (/reminders) ---
# Create a free Supabase project at https://supabase.com, run supabase/schema.sql
# in its SQL editor, then copy the values from Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Any random string — required as ?token=... on /api/reminders-check so only
# your scheduled pinger can trigger reminder emails. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=replace_with_a_random_string
REMINDERS_AUTH_TOKEN=replace_with_a_different_random_string

# Optional: browser push notifications for /reminders (free, no third-party service).
# Generate a keypair with:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log('PUBLIC:',k.publicKey); console.log('PRIVATE:',k.privateKey);"
# REACT_APP_VAPID_PUBLIC_KEY must be the SAME value as VAPID_PUBLIC_KEY — the
# REACT_APP_ prefix is what makes Create React App bake it into the browser bundle.
VAPID_PUBLIC_KEY=replace_with_generated_public_key
VAPID_PRIVATE_KEY=replace_with_generated_private_key
VAPID_SUBJECT=mailto:team@timingotech.com
REACT_APP_VAPID_PUBLIC_KEY=replace_with_generated_public_key

# --- Job Finder page (/jobs) ---
# RemoteOK and Arbeitnow work out of the box with no key. Adzuna is optional —
# sign up for a free key at https://developer.adzuna.com to add its listings too.
ADZUNA_APP_ID=replace_with_adzuna_app_id
ADZUNA_APP_KEY=replace_with_adzuna_app_key
ADZUNA_COUNTRY=us

# Jooble is also optional — free signup (500 req/mo) at https://jooble.org/api/about
JOOBLE_API_KEY=replace_with_jooble_api_key

# TheirStack is also optional — IMPORTANT: it bills 1 credit per job RETURNED
# (not per request), so the integration deliberately requests a small page size.
# Get a key at https://theirstack.com
THEIRSTACK_API_KEY=replace_with_theirstack_api_key

# "Fill from resume" — analyzes an uploaded resume to suggest search filters.
# Get a key at https://platform.openai.com/api-keys (uses gpt-4o-mini, ~fractions of a cent per resume).
OPENAI_API_KEY=replace_with_openai_api_key
