# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Configuration
FROM_NAME="TimingoTech"
FROM_EMAIL=team@timingotech.com
ADMIN_EMAIL=team@timingotech.com

# For Vercel deployment, add RESEND_API_KEY to Environment Variables:
# 1. Go to your Vercel project settings
# 2. Navigate to "Environment Variables"
# 3. Add: RESEND_API_KEY=re_JRn1Ku9c_65t4wYW4stBfhNKrjxGHksxb

# --- Reminders page (/reminders) ---
# Create a free Supabase project at https://supabase.com, run supabase/schema.sql
# in its SQL editor, then copy the values from Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Any random string — required as ?token=... on /api/reminders-check so only
# your scheduled pinger can trigger reminder emails. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=replace_with_a_random_string
