# Copy this file to .env and fill in real values. DO NOT commit .env with secrets.

# SMTP settings (Zoho SMTP example)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=team@timingotech.com
SMTP_PASS=your_app_password_here

# From address used when sending emails
FROM_NAME="TimingoTech"
FROM_EMAIL=team@timingotech.com

# Admin recipient for contact form submissions
ADMIN_EMAIL=hello@timingotech.com

# Server port
PORT=5000
